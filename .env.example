# Khusus demonstrasi LOCAL. Ganti dengan password sendiri, jangan commit .env.
POSTGRES_PASSWORD=ganti_password_lokal_yang_kuat

# LibraryKu Unified (MongoDB). Ganti keduanya dengan password acak yang berbeda, jangan commit .env.
MONGO_ROOT_PASSWORD=ganti-dengan-password-acak-1
MONGO_APP_PASSWORD=ganti-dengan-password-acak-2

# Akses publik: biarkan kosong (bawaan 127.0.0.1) agar port 8081 hanya terbuka di Kali. Isi 0.0.0.0 hanya bila perlu akses LAN/NAT.
# FRONTEND_BIND=127.0.0.1
